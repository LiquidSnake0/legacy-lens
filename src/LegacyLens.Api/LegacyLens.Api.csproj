<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <!--
      Pinned above what Microsoft.Data.Sqlite pulls in: 2.1.11 carries
      GHSA-2m69-gcr7-jv3q. Remove once the transitive dependency catches up.
    -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LegacyLens.Analysis\LegacyLens.Analysis.csproj" />
    <!--
      Reachable from the command line only. Characterization loads an assembly
      and calls into it, and an HTTP route that did that would be remote code
      execution with a JSON body. It is referenced here because the command
      lives in this executable, and it is deliberately mapped to no endpoint.
    -->
    <ProjectReference Include="..\LegacyLens.Characterization\LegacyLens.Characterization.csproj" />
  </ItemGroup>


  <ItemGroup>
    <!-- Merge stays internal: it is how retrieval works, not what it offers. -->
    <InternalsVisibleTo Include="LegacyLens.Tests" />
  </ItemGroup>

</Project>
