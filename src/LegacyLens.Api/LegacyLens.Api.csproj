<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <!--
      Pinned above what Microsoft.Data.Sqlite pulls in: 2.1.11 carries
      GHSA-2m69-gcr7-jv3q. Remove once the transitive dependency catches up.
    -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <!--
      The PDF of the assessment. Held at 6.2.4 on purpose: it is the last
      release under MIT, and from 6.5.0 the package is AGPL-3.0, which a tool
      published under MIT and handed over as one executable cannot take.
      Managed code only, no native library, so the single file stays one file
      and nothing it does needs a network.
    -->
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <!--
      Pinned above what PDFsharp 6.2.4 pulls in: 8.0.1, and every release up
      to 10.0.12, carries GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LegacyLens.Analysis\LegacyLens.Analysis.csproj" />
    <!--
      Reachable from the command line only. Characterization loads an assembly
      and calls into it, and an HTTP route that did that would be remote code
      execution with a JSON body. It is referenced here because the command
      lives in this executable, and it is deliberately mapped to no endpoint.
    -->
    <ProjectReference Include="..\LegacyLens.Characterization\LegacyLens.Characterization.csproj" />
  </ItemGroup>


  <ItemGroup>
    <!--
      The typefaces the PDF is set in, inside the executable rather than looked
      up on the machine: Montserrat and DejaVu Sans Mono are on almost no
      Windows machine, and a report that changes face depending on where it was
      printed is not the same document twice. Subset to Latin and Cyrillic,
      licences beside them.
    -->
    <EmbeddedResource Include="Pdf/Fonts/*.ttf" LogicalName="Fonts.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Merge stays internal: it is how retrieval works, not what it offers. -->
    <InternalsVisibleTo Include="LegacyLens.Tests" />
  </ItemGroup>

</Project>
