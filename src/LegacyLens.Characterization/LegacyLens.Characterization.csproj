<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      Referencing xunit is enough for the SDK to treat this as a test project
      and hand it to the test host, which then fails to start it. It is a
      library that compiles tests, not one that runs any.
    -->
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Compiling the generated tests is how they get checked, so the compiler is
      a dependency of the checking rather than of the analysis.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <!--
      Referenced so that generated tests can be compiled against Fact and
      Assert, not so that anything here runs xunit. The generated file is
      checked by invoking its methods directly; a full test host would add a
      process launch to something that has to stay a library call.
    -->
    <PackageReference Include="xunit" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LegacyLens.Tests" />
  </ItemGroup>

</Project>
