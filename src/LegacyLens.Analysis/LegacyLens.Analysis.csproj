<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ILSpy's engine, for an assessment of a codebase whose source is gone:
      the assemblies are read for their metadata, and the target framework is
      detected the way ILSpy detects it. MIT.
    -->
    <PackageReference Include="ICSharpCode.Decompiler" Version="11.1.0.9782" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
  </ItemGroup>


  <ItemGroup>
    <!--
      Parsing helpers stay internal: they are implementation, not API. Tests
      still reach them, because the parsing is precisely what is worth pinning.
    -->
    <InternalsVisibleTo Include="LegacyLens.Tests" />
  </ItemGroup>

</Project>
