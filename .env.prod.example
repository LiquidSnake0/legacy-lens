# Copy to .env on the server. .env is gitignored.

# The name Caddy answers on, and gets a certificate for. Use ":80" to serve
# plain HTTP, which is for trying this locally and not for a public address.
LENS_DOMAIN=lens.example.com

# The one account. Generate the hash with:
#   docker run --rm caddy caddy hash-password --plaintext 'your password'
LENS_USER=you
LENS_PASSWORD_HASH=$2a$14$...

# Which published images to run. A commit sha pins it to something known;
# latest moves under you on the next push.
LENS_VERSION=latest

EMBED_MODEL=nomic-embed-text
CHAT_MODEL=qwen2.5-coder:3b

# Whether the server may run the code it is handed, which is what comparing the
# behaviour of two versions requires. Left unset on purpose: with it on, a file
# that gets run can do whatever the API can, and on a rewrite a model wrote that
# is executing something nobody has read.
#
# The command needs none of this and is the better way in:
#   docker compose exec api dotnet LegacyLens.Api.dll equivalence Before.cs After.cs
# ALLOW_RUNNING_CODE=true
