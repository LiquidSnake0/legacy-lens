# Copy to .env and adjust. .env is gitignored.

# Where the repositories you want to index live on the host.
# Mounted read-only at /repos inside the container.
REPOS_PATH=./repos

# Embeddings. Local, always. 274 MB, fast on CPU.
EMBED_MODEL=nomic-embed-text

# Generation. Pick to match available RAM:
#   qwen2.5-coder:1.5b  ~1 GB    constrained machines, noticeably weaker
#   qwen2.5-coder:3b    ~2 GB    the default
#   qwen2.5-coder:7b    ~4.7 GB  better, if the RAM is there
CHAT_MODEL=qwen2.5-coder:3b

CORS_ORIGIN=http://localhost:4200
